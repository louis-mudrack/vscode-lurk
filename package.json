{
  "name": "lurk",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "louis-mudrack",
  "private": true,
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Louis Mudrack"
  },
  "homepage": "https://github.com/louis-mudrack/twitch-video-player-vsc-extension#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/louis-mudrack/twitch-video-player-vsc-extension"
  },
  "bugs": {
    "url": "https://github.com/louis-mudrack/twitch-video-player-vsc-extension/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "twitch",
    "stream",
    "livestream",
    "player",
    "video",
    "chat",
    "7tv",
    "raid",
    "lurk",
    "arbeitszeitbetrug"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1b1030",
    "theme": "dark"
  },
  "pricing": "Free",
  "l10n": "./l10n",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "twitchPlayer.player",
          "name": "%view.player%",
          "icon": "media/player.svg",
          "contextualTitle": "Lurk"
        },
        {
          "type": "webview",
          "id": "twitchPlayer.chat",
          "name": "%view.chat%",
          "icon": "media/chat.svg",
          "contextualTitle": "Lurk",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "twitchPlayer.openChannel",
        "title": "%command.openChannel%",
        "category": "Lurk",
        "icon": "$(search)"
      },
      {
        "command": "twitchPlayer.stop",
        "title": "%command.stop%",
        "category": "Lurk",
        "icon": "$(debug-stop)"
      },
      {
        "command": "twitchPlayer.openInBrowser",
        "title": "%command.openInBrowser%",
        "category": "Lurk",
        "icon": "$(link-external)"
      },
      {
        "command": "twitchPlayer.showChat",
        "title": "%command.showChat%",
        "category": "Lurk",
        "icon": "$(comment-discussion)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "twitchPlayer.openChannel",
          "when": "view == twitchPlayer.player",
          "group": "navigation@1"
        },
        {
          "command": "twitchPlayer.showChat",
          "when": "view == twitchPlayer.player && twitchPlayer.hasChannel",
          "group": "navigation@2"
        },
        {
          "command": "twitchPlayer.openInBrowser",
          "when": "view == twitchPlayer.player && twitchPlayer.hasChannel",
          "group": "navigation@3"
        },
        {
          "command": "twitchPlayer.stop",
          "when": "view == twitchPlayer.player && twitchPlayer.hasChannel",
          "group": "navigation@4"
        }
      ],
      "commandPalette": [
        {
          "command": "twitchPlayer.stop",
          "when": "twitchPlayer.hasChannel"
        },
        {
          "command": "twitchPlayer.openInBrowser",
          "when": "twitchPlayer.hasChannel"
        },
        {
          "command": "twitchPlayer.showChat",
          "when": "twitchPlayer.hasChannel"
        }
      ]
    },
    "configuration": {
      "title": "Lurk",
      "properties": {
        "twitchPlayer.followRaids": {
          "type": "boolean",
          "default": true,
          "description": "%config.followRaids%"
        },
        "twitchPlayer.quality": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "1080p",
            "720p",
            "480p",
            "360p",
            "160p"
          ],
          "enumDescriptions": [
            "%config.quality.auto%",
            "%config.quality.1080p%",
            "%config.quality.720p%",
            "%config.quality.480p%",
            "%config.quality.360p%",
            "%config.quality.160p%"
          ],
          "description": "%config.quality%"
        },
        "twitchPlayer.resumeLastChannel": {
          "type": "boolean",
          "default": false,
          "description": "%config.resumeLastChannel%"
        },
        "twitchPlayer.chat.maxMessages": {
          "type": "number",
          "default": 200,
          "minimum": 20,
          "maximum": 1000,
          "description": "%config.chat.maxMessages%"
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/webview/tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "vscode:prepublish": "node scripts/build.mjs --production",
    "package": "vsce package --no-dependencies",
    "test:e2e": "npm run build && node test/e2e/run.mjs",
    "l10n": "vscode-l10n-dev export --outDir ./l10n ./src"
  },
  "dependencies": {
    "@vscode/l10n": "^0.0.18",
    "@wasm-audio-decoders/aac": "0.0.1",
    "hls.js": "1.7.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.20.5",
    "@types/vscode": "1.95.0",
    "@types/ws": "^8.18.2",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
